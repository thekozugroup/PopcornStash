# Build context for the Dockerfile: sources only.
.git
.github
.claude
.agents
.impeccable
**/target
**/node_modules
web/dist
extension
evidence
test-results
playwright-report
dev-data
docs
unraid
scripts
*.md
!web/**/*.md

# Never send secrets or personal files to the builder, from any folder. Vite would
# also bake a web/.env* file into the UI.
**/.env
**/.env.*
**/*.ovpn
**/*.ovpn.auth
**/openvpn.auth
**/wireguard.conf
**/internal.token
**/*.pem
**/*.key
**/*.db
**/*.db-shm
**/*.db-wal
**/*.zip
**/.DS_Store
