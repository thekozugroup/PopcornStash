# PopcornStash settings for compose.yaml. Copy to .env and edit.
# Keep .env private; it is ignored by git.

# The address everyone will open, including https://. Passkeys only work on HTTPS
# with a domain name (or http://localhost for a test on this computer). Required.
STASH_PUBLIC_URL=https://stash.example.com

# Existing folders on this computer. Both must exist before the first start.
# App data: database, thumbnails, settings, VPN files. Keep it on fast storage.
APPDATA_PATH=/srv/popcornstash/appdata
# Your library: Movies, Shows, Home Videos, Photos, Other, Inbox and Downloads live here.
STASH_PATH=/srv/media/PopcornStash

# User and group that own every file PopcornStash writes. Use the numbers of the
# account that owns STASH_PATH (`id -u` and `id -g`). Unraid: PUID=99 and PGID=100.
PUID=1000
PGID=1000

# Port on this computer for the web app.
STASH_PORT=8788

# Set to true when a reverse proxy (Caddy, Nginx Proxy Manager, SWAG, Cloudflare
# Tunnel, Tailscale Serve) sits in front, so sign-in limits see real visitor addresses.
# Leave false when the port is reachable directly.
STASH_TRUST_PROXY=false

# Optional. Hardware video encoding for playback that needs converting. Leave empty to
# choose it in Settings > System > Streaming. Set to none, vaapi, qsv or nvenc to fix it
# here instead: the setting then follows this value until you empty it again.
# vaapi and qsv also need the /dev/dri device line in compose.yaml.
STASH_HWACCEL=

# Optional. Extra addresses that may open the app (comma separated, same domain),
# for example a second port on the same name. Most people leave this empty.
STASH_EXTRA_ORIGINS=

# Optional. Lets the PopcornStash Android app sign in with your passkeys: the Digital
# Asset Links statement, on one line, in single quotes. docs/android.md has the exact
# text and how to find your app's certificate fingerprint. Empty: the app pairs with a code.
STASH_ANDROID_ASSETLINKS=

# Optional. User number the torrent engine runs as. It must not be 0 or PUID.
# Change it only if 6881 is already used for something else on this computer.
STASH_TORRENT_UID=6881

# Optional. Log detail: info (default), debug, or warn.
STASH_LOG=info

# Optional. Your time zone, for example Europe/Berlin or America/New_York. Photos and
# videos whose files do not say where they were taken (only a file time, or the UTC
# time most Android phones put in their videos) get their date and time in this zone.
# Empty means UTC.
TZ=

# Not set here on purpose: STASH_ALLOW_NO_VPN. It lets torrents run without a
# tunnel and is only for networks whose router already sends everything through a
# VPN. Read "Running without a VPN" in docs/vpn.md before adding it to compose.yaml.
