<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      No backups and no device transfer: the token, caches and lists hold the family's
      pictures and names (docs/architecture.md section 10).
    -->
    <application
        android:name=".PopcornStashApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PopcornStash">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Opening an Other file in another app: a private copy in cacheDir/opened is shared as a
          content:// address with a one-time read grant (docs/architecture.md section 10).
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/opened_files" />
        </provider>

        <!--
          The player (feature/player): its own activity for picture-in-picture, landscape and
          hidden system bars. singleTask, so playing something else while it is in
          picture-in-picture replaces what plays. It handles size, orientation and theme
          changes itself, so the video never stops for them.
        -->
        <activity
            android:name=".feature.player.PlayerActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="false"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.PopcornStash.Player" />
    </application>
</manifest>
