<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Share sheet uploads: a foreground job with a progress notification (share/). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!--
      Installing a newer build of this app from GitHub (update/, docs/android.md, Updates). The
      second lets Android 12 and later install the app's own update without asking each time
      (PackageInstaller.SessionParams.setRequireUserAction); it is a normal permission.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!--
      No backups and no device transfer: the token, caches and lists hold the family's
      pictures and names (docs/architecture.md section 10).
    -->
    <application
        android:name=".PopcornStashApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PopcornStash">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Opening an Other file in another app: a private copy in cacheDir/opened is shared as a
          content:// address with a one-time read grant (docs/architecture.md section 10).
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/opened_files" />
        </provider>

        <!--
          The player (feature/player): its own activity for picture-in-picture, landscape and
          hidden system bars. singleTask, so playing something else while it is in
          picture-in-picture replaces what plays. It handles size, orientation and theme
          changes itself, so the video never stops for them.
        -->
        <activity
            android:name=".feature.player.PlayerActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="false"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.PopcornStash.Player" />

        <!--
          The share sheet (share/ShareActivity): links and magnets go to Downloads, photos,
          videos and files are uploaded, each after the person confirms. Files are taken only
          as content:// URIs from another app (share/SharedContent.kt).
        -->
        <activity
            android:name=".share.ShareActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.PopcornStash.Share"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!--
          PackageInstaller's answer about an update (update/UpdateInstallReceiver): Android's
          confirmation to show, or how the install ended. Only the PendingIntent the app hands
          the install session reaches it.
        -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />

        <!-- WorkManager's foreground service runs the upload job ([UploadWorker]) and the update download. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>
</manifest>
