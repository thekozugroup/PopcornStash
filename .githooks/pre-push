#!/usr/bin/env bash
# Runs scripts/check.sh before anything is pushed to main, in place of a CI service.
# Opt in once per clone:   git config core.hooksPath .githooks
# Skip it for one push:     git push --no-verify
# It checks the working tree as it is, so commit or stash other changes first.
set -euo pipefail

pushes_main=0
while read -r local_ref _ remote_ref _; do
  if [[ "$remote_ref" == refs/heads/main && "$local_ref" != "(delete)" ]]; then
    pushes_main=1
  fi
done
((pushes_main)) || exit 0

cd "$(git rev-parse --show-toplevel)"
if [[ -n "$(git status --porcelain --untracked-files=normal)" ]]; then
  printf 'pre-push: the working tree has uncommitted changes, so the checks below test more than the commits being pushed\n' >&2
fi
exec scripts/check.sh </dev/null
