{
  "name": "popcornstash-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PopcornStash Chrome extension: send links, media and downloads to your PopcornStash server",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit && vitest run",
    "test": "vitest run",
    "test:e2e": "node scripts/build.mjs && playwright test",
    "zip": "node scripts/build.mjs && node scripts/zip.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/chrome": "^0.3.5",
    "@types/node": "^22.20.5",
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
